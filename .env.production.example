# =============================================================
# HR-Portal — Production Environment
# Kopiere als .env.production und passe die Werte an
# =============================================================

# Datenbank (wird von docker-compose gesetzt)
DB_PASSWORD=HIER_SICHERES_PASSWORT
DATABASE_URL=postgresql://hrportal:${DB_PASSWORD}@db:5432/hr_portal?schema=public

# Auth — MUSS geaendert werden!
# Generieren mit: openssl rand -base64 48
JWT_SECRET=HIER_LANGES_ZUFAELLIGES_GEHEIMNIS

# Verschluesselung sensibler Daten (IBAN, SV-Nr, Steuer-ID)
# Generieren mit: openssl rand -hex 32
ENCRYPTION_KEY=HIER_64_ZEICHEN_HEX_STRING

# Magic Link Gueltigkeit
MAGIC_LINK_EXPIRY_HOURS=720

# Cron-Endpunkt Absicherung
# Generieren mit: openssl rand -base64 24
CRON_SECRET=HIER_CRON_SECRET

# n8n Integration
N8N_API_KEY=

# App
APP_URL=https://hr.fes-credo.de
NODE_ENV=production

# Datei-Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# SMTP (optional, Fallback wenn n8n nicht verfuegbar)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hr-portal@fes-credo.de
