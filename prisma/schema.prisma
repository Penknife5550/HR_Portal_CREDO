// =============================================
// VERBEAMTUNG (PSI) — Sprint 5
// 11-Schritte-Prozess, 4 Phasen, 8 Gatekeeper
// =============================================

enum CivilServiceType {
  PROBE // PSI auf Probe (3 Jahre)
  LIFETIME // PSI auf Lebenszeit
}

enum CivilServiceStatus {
  DRAFT // Antrag in Vorbereitung
  PREREQUISITES_CHECK // Voraussetzungen werden geprüft
  ASSESSMENT_PENDING // Beurteilung durch SL ausstehend
  REFERENCE_PENDING // Referenz durch SL ausstehend
  BOARD_PENDING // Beiratsentscheidung ausstehend
  BOARD_POSTPONED // Beirat hat aufgeschoben
  ADMINISTRATION // Verwaltungsvorgang läuft (Phase II)
  PROBATION // Probezeit (Phase III)
  LIFETIME_PENDING // Übernahme Lebenszeit läuft (Phase IV)
  COMPLETED // Abgeschlossen
  REJECTED // Abgelehnt
  CANCELLED // Abgebrochen
}

enum CivilServicePhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  SKIPPED
}

enum BoardDecisionResult {
  POSITIVE
  NEGATIVE
  POSTPONED
}

// =============================================
// Verbeamtungsvorgang (Haupttabelle)
// =============================================
model CivilServiceProcess {
  id               String @id @default(uuid())
  displayId        String @unique // z.B. "PSI-2026-GYM-001"
  sequentialNumber Int

  // Verknüpfungen
  employeeId     String?
  employee       Employee?    @relation("EmployeeCivilService", fields: [employeeId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  initiatedById  String
  initiatedBy    User         @relation("CivilServiceInitiator", fields: [initiatedById], references: [id])

  // Mitarbeiter-Daten (inline für Abwärtskompatibilität)
  employeeFirstName  String
  employeeLastName   String
  employeeEmail      String
  employeePersonalNr String?

  // Typ und Status
  type        CivilServiceType   @default(PROBE)
  status      CivilServiceStatus @default(DRAFT)
  currentStep Int                @default(1) // 1-11

  // Voraussetzungen (JSON: 12 Kriterien aus 3.1)
  prerequisites Json?

  // Termine
  targetStartDate    DateTime? // Geplanter Vertragsbeginn
  probationStartDate DateTime? // Tatsächlicher Probezeit-Beginn
  probationEndDate   DateTime? // Probezeit-Ende (berechnet: +3 Jahre)
  completedAt        DateTime?

  // Besoldung
  besoldungsgruppe   String? // z.B. "A13"
  erfahrungsstufe    Int? // 1-12
  vordienszeitenJson Json? // Berechnungsgrundlage

  // LK-Antrag Magic Link
  applicationToken          String?   @unique
  applicationTokenExpiresAt DateTime?
  applicationSubmittedAt    DateTime?
  applicationData           Json? // Antworten der Lehrkraft

  // Beteiligte Personen (Schulleitung, Amtsarzt, Beirat etc.)
  stakeholders Json? // { schulleitung: {name, email}, amtsarzt: {email}, beirat: {email} }

  // Relationen
  phases         CivilServicePhase[]
  assessments    CivilServiceAssessment[]
  boardDecisions CivilServiceBoardDecision[]
  documents      CivilServiceDocument[]
  checklistItems CivilServiceChecklistItem[]
  auditLogs      AuditLog[]                  @relation("CivilServiceAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([employeeId])
  @@map("civil_service_processes")
}

// =============================================
// Phasen-Status (A-H + Hauptphasen)
// =============================================
model CivilServicePhase {
  id        String              @id @default(uuid())
  processId String
  process   CivilServiceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  phaseKey   String // "I", "II_A", "II_B", ..., "II_H", "III", "IV"
  phaseName  String // "Amtsarzt", "Besoldung", etc.
  orderIndex Int    @default(0)

  status        CivilServicePhaseStatus @default(PENDING)
  startedAt     DateTime?
  completedAt   DateTime?
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([processId, phaseKey])
  @@index([processId])
  @@map("civil_service_phases")
}

// =============================================
// Beurteilungen (3 Pflichtbeurteilungen via Magic Link)
// =============================================
model CivilServiceAssessment {
  id        String              @id @default(uuid())
  processId String
  process   CivilServiceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  assessmentNumber Int // 1, 2 oder 3
  assessmentType   String // "BEURTEILUNG" oder "REFERENZ"

  // Magic Link für SL
  token          String   @unique
  tokenExpiresAt DateTime
  recipientEmail String // SL E-Mail
  recipientName  String?

  // Tracking
  sentAt        DateTime?
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)
  submittedAt   DateTime?

  // Bewertung (JSON: Noten pro Kriterium)
  templateId              String? // Verweis auf BeurteilungTemplate (Audit/Versionierung)
  scaleType               String?  @default("BRL_1_5") // BRL_1_5 oder SCHULNOTEN_1_6
  templateSnapshot        Json? // Beurteilungsvorlage (eingefroren, inkl. scaleType + scaleLabels)
  ratingsData             Json? // Noten pro Kriterium
  overallGrade            Float? // Visualisierung — Gesamtschnitt (KEIN Gesamturteil!)
  meetsRequirements       Boolean? // Legacy: automatische Berechnung
  meetsRequirementsManual Boolean? // BRL Nr. 7.5 — manuelles Gesamturteil der SL
  overallReasoning        String? // Pflichtbegründung Gesamturteil (min. 200 Zeichen)

  // Referenz-Daten (nur bei assessmentNumber 1 + 3)
  referenceData    Json? // 12 Prüfpunkte (Ja/Nein/Teilweise)
  gemeindeReferenz String? // Freitext Gemeinde-Referenz

  // Workflow — Vorbereitung
  scheduledDate       DateTime? // Termin Unterrichtsbesuch
  announcedAt         DateTime? // Ankündigungs-Zeitpunkt (BRL Nr. 8.3 — min. 14 Tage vorher)
  fach                String? // Unterrichtsfach
  klasse              String? // Klasse / Lerngruppe
  vertrauenslehrkraft String? // BRL Nr. 8.3 — Optionaler Name der Vertrauenslehrkraft
  unbiasedConfirmed   Boolean? // BRL Nr. 4.10 — Befangenheitserklärung der SL
  unbiasedConfirmedAt DateTime?

  // Workflow — Nachbesprechung & Beurteilungsgespräch
  postReviewAt               DateTime? // BRL Nr. 9.1 — Nachbesprechung (zeitnah)
  postReviewNotes            String?
  beurteilungsgespraechAt    DateTime? // BRL Nr. 10.1 — Beurteilungsgespräch (zwingend vor Abfassung)
  beurteilungsgespraechNotes String?

  // Workflow — Bekanntgabe + Gegenäußerung (§ 92 Abs. 1 Satz 6 LBG NRW)
  employeeAckToken         String?   @unique
  employeeAckExpiresAt     DateTime?
  releasedToEmployeeAt     DateTime? // Wann hat HR den Bekanntgabe-Link generiert
  acknowledgedByEmployeeAt DateTime?
  acknowledgedByEmployeeIp String? // IP für Beweisbarkeit
  rebuttalText             String? // Gegenäußerung der Lehrkraft
  rebuttalAt               DateTime?

  // Workflow — Archivierung (BRL Nr. 14 + § 92 LBG NRW)
  // Final in Personalakte aufgenommen — Schritt 9 (COMPLETED).
  // Erst nach acknowledgedByEmployeeAt erlaubt.
  archivedAt   DateTime?
  archivedById String?

  // Public Verify (Phase 6 — Audit-Page für Bezirksregierung)
  verifyToken String? @unique // separate UUID, nie identisch mit token

  // Reminder
  lastReminderAt DateTime?
  reminderCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([processId, assessmentNumber, assessmentType])
  @@index([processId])
  @@map("civil_service_assessments")
}

// =============================================
// Beurteilungs-Vorlagen (konfigurierbar wie ZeugnisBewertungTemplate)
//
// Pro CREDO-Mandant kann ein Override angelegt werden (organizationId).
// Wenn organizationId == null → globaler Default für alle Schulen.
// Genau ein Eintrag pro Scope sollte isDefault: true tragen.
//
// scaleType:
//   - "BRL_1_5"        → 5-Punkte-Skala BRL Nr. 7.3 (5 = Übertrifft besonders)
//   - "SCHULNOTEN_1_6" → klassische Schulnoten (1 = sehr gut)
//
// scaleLabels: JSON mit den Labels pro Punkt, z.B.
//   {"5":"Übertrifft die Anforderungen in besonderem Maße", "4":"...", ...}
//
// legalReference (pro Kategorie): freier Verweis wie "BRL Nr. 6.1 Merkmal 1".
// =============================================
model BeurteilungTemplate {
  id             String        @id @default(uuid())
  name           String
  description    String?
  scaleType      String // "BRL_1_5" | "SCHULNOTEN_1_6"
  scaleLabels    Json // {"5":"...", "4":"...", ...}
  organizationId String? // null = global, sonst Mandanten-Override
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isActive       Boolean       @default(true)
  isDefault      Boolean       @default(false)
  version        Int           @default(1)

  categories BeurteilungTemplateCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([isActive])
  @@map("beurteilung_templates")
}

model BeurteilungTemplateCategory {
  id         String              @id @default(uuid())
  templateId String
  template   BeurteilungTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  weight         Float   @default(1.0)
  orderIndex     Int     @default(0)
  isMandatory    Boolean @default(false) // BRL-Pflichtmerkmal?
  legalReference String? // z.B. "BRL Nr. 6.1 Merkmal 1"

  criteria BeurteilungTemplateCriterion[]

  createdAt DateTime @default(now())

  @@index([templateId])
  @@map("beurteilung_template_categories")
}

model BeurteilungTemplateCriterion {
  id         String                      @id @default(uuid())
  categoryId String
  category   BeurteilungTemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String?
  weight      Float   @default(1.0)
  orderIndex  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([categoryId])
  @@map("beurteilung_template_criteria")
}

// =============================================
// Beiratsentscheidungen
// =============================================
model CivilServiceBoardDecision {
  id        String              @id @default(uuid())
  processId String
  process   CivilServiceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  decisionType     String // "PROBE" oder "LIFETIME"
  result           BoardDecisionResult
  decisionDate     DateTime
  notes            String?
  protocolUploadId String? // Verweis auf Dokument

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processId])
  @@map("civil_service_board_decisions")
}

// =============================================
// Dokumente (33+ Dokumenttypen)
// =============================================
model CivilServiceDocument {
  id        String              @id @default(uuid())
  processId String
  process   CivilServiceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  documentType String // "AMTSARZT", "VERTRAG_PROBE", "BR_GENEHMIGUNG", etc.
  documentName String // Anzeigename
  step         String? // Zuordnung zum Schritt (z.B. "6.A", "6.C")

  // Datei
  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  // Status
  status     String    @default("PENDING") // PENDING, UPLOADED, APPROVED, EXPIRED, GENERATED
  uploadedAt DateTime?
  approvedAt DateTime?
  expiresAt  DateTime? // z.B. Amtsarzt: 3 Monate Gültigkeit

  // Auto-Generierung
  isGenerated Boolean   @default(false) // Vom System generiert?
  generatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processId])
  @@index([documentType])
  @@map("civil_service_documents")
}

// =============================================
// Checkliste (40+ Aufgaben, phasenweise)
// =============================================
model CivilServiceChecklistItem {
  id        String              @id @default(uuid())
  processId String
  process   CivilServiceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  step        String // "1", "2", "3", ..., "6.A.1", "6.C.4", "7.3", etc.
  phase       String // "I", "II_A", "II_B", ..., "III", "IV"
  category    String // "Antrag", "Amtsarzt", "Vertrag", etc.
  title       String
  description String?

  // Zuständigkeit
  assignee     String // "HR", "SL", "LK", "EXTERN", "BEIRAT"
  assigneeName String? // Konkreter Name falls bekannt

  // Status
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?

  // Fristen
  dueDate      DateTime?
  isGatekeeper Boolean   @default(false) // Blockiert nächsten Schritt?
  isOverdue    Boolean   @default(false)

  // Verknüpfung zu Dokument
  linkedDocumentType String? // z.B. "AMTSARZT" — wenn Dokument hochgeladen, Item automatisch erledigt

  orderIndex Int     @default(0)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processId])
  @@index([phase])
  @@map("civil_service_checklist_items")
}

// =============================================
// MUTTERSCHUTZ & ELTERNZEIT — Phase 1 MVP
// Rechtsgrundlagen: BEEG, MuSchG, FrUrlV NRW, TV-L
// =============================================

// =============================================
// Mutterschutz-Vorgang (eigenständiger Prozess, MuSchG)
// Wird i. d. R. mit ElternzeitProzess verknuepft, kann aber alleinstehen.
// Vaeter haben KEINEN Mutterschutz.
// =============================================
model MutterschutzProzess {
  id               String @id @default(uuid())
  displayId        String @unique // z.B. "MU-2026-GYM-001"
  sequentialNumber Int

  // Verknuepfungen
  employeeId     String?
  employee       Employee?    @relation("EmployeeMutterschutz", fields: [employeeId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  initiatedById  String
  initiatedBy    User         @relation("MutterschutzInitiator", fields: [initiatedById], references: [id])

  // Mitarbeiterin-Daten (inline, wie bei CivilService)
  employeeFirstName  String
  employeeLastName   String
  employeeEmail      String
  employeePersonalNr String?

  // Schwangerschaftsdaten
  voraussGeburt      DateTime
  tatsGeburt         DateTime?
  mutterschutzBeginn DateTime // berechnet: voraussGeburt - 42 Tage (6 Wochen)
  mutterschutzEnde   DateTime? // berechnet: tatsGeburt + 56 oder 84 Tage
  fruehgeburt        Boolean   @default(false)
  mehrlinge          Boolean   @default(false)

  // BAD (Betriebsaerztlicher Dienst) — nur Kita / Schulen mit Kinderkontakt
  einrichtungstyp       MutterschutzEinrichtungstyp @default(SCHULE)
  badErforderlich       Boolean                     @default(false)
  badBeauftragtAm       DateTime?
  badAbgeschlossenAm    DateTime?
  badErgebnis           String? // Freitext
  beschaeftigungsverbot Boolean                     @default(false)
  alternativeTaetigkeit String?

  // Lohnbescheinigung
  lohnbeschKkErstelltAm DateTime?

  // Status
  status MutterschutzStatus @default(GEMELDET)

  // Verknuepfte Elternzeit-Vorgaenge (1 Mutterschutz → N Elternzeiten)
  elternzeitProzesse ElternzeitProzess[] @relation("MutterschutzZuElternzeit")

  // Sub-Modelle
  dokumente      MutterschutzDokument[]
  notizen        MutterschutzNotiz[]
  checklistItems MutterschutzChecklistItem[]
  auditLogs      AuditLog[]                  @relation("MutterschutzAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([employeeId])
  @@map("mutterschutz_prozesse")
}

enum MutterschutzStatus {
  GEMELDET
  BAD_BEAUFTRAGT
  BAD_ABGESCHLOSSEN
  AKTIV
  BEENDET
}

enum MutterschutzEinrichtungstyp {
  SCHULE // ohne BAD-Pflicht (außer expliziter Kinderkontakt)
  KITA // immer BAD-Pflicht
  VERWALTUNG // ohne BAD
}

model MutterschutzDokument {
  id             String                  @id @default(uuid())
  mutterschutzId String
  mutterschutz   MutterschutzProzess     @relation(fields: [mutterschutzId], references: [id], onDelete: Cascade)
  dokumentTyp    MutterschutzDokumentTyp
  dateiname      String
  dateipfad      String
  mimeType       String?
  fileSize       Int?
  generiert      Boolean                 @default(false) // true = vom System erzeugt
  hochgeladenAm  DateTime                @default(now())
  hochgeladenVon String?

  @@index([mutterschutzId])
  @@map("mutterschutz_dokumente")
}

enum MutterschutzDokumentTyp {
  BAD_AUFFORDERUNG
  BAD_BESCHEINIGUNG
  GEFAEHRDUNGSBEURTEILUNG
  LOHNBESCHEINIGUNG_KK
  AERZTLICHES_ZEUGNIS
  SONSTIGES
}

model MutterschutzNotiz {
  id             String              @id @default(uuid())
  mutterschutzId String
  mutterschutz   MutterschutzProzess @relation(fields: [mutterschutzId], references: [id], onDelete: Cascade)
  text           String
  erstelltVon    String
  createdAt      DateTime            @default(now())

  @@index([mutterschutzId])
  @@map("mutterschutz_notizen")
}

model MutterschutzChecklistItem {
  id             String              @id @default(uuid())
  mutterschutzId String
  mutterschutz   MutterschutzProzess @relation(fields: [mutterschutzId], references: [id], onDelete: Cascade)
  titel          String
  beschreibung   String?
  logaHinweis    String? // ausfuehrlicher LOGA-Klickpfad
  erledigtAm     DateTime?
  erledigtVon    String?
  personalgruppe Personalgruppe? // null = alle Gruppen
  orderIndex     Int                 @default(0)

  @@index([mutterschutzId])
  @@map("mutterschutz_checkliste")
}

// =============================================
// Elternzeit-Vorgang (eigenstaendig, BEEG / FrUrlV NRW)
// =============================================
model ElternzeitProzess {
  id               String @id @default(uuid())
  displayId        String @unique // z.B. "EZ-2026-GYM-001"
  sequentialNumber Int

  // Verknuepfungen
  employeeId     String?
  employee       Employee?    @relation("EmployeeElternzeit", fields: [employeeId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  initiatedById  String
  initiatedBy    User         @relation("ElternzeitInitiator", fields: [initiatedById], references: [id])

  // Mitarbeiter-Daten (inline)
  employeeFirstName  String
  employeeLastName   String
  employeeEmail      String
  employeePersonalNr String?

  // Verknuepfung zu Mutterschutz (optional, nur bei Mutter)
  mutterschutzId String?
  mutterschutz   MutterschutzProzess? @relation("MutterschutzZuElternzeit", fields: [mutterschutzId], references: [id])

  // Personalgruppe & Geschlecht (bestimmt Workflow + Briefvorlagen)
  personalgruppe Personalgruppe
  geschlecht     Geschlecht
  kvTyp          KVTyp

  // Kind-Daten
  kindName           String?
  kindGeburtsdatum   DateTime?
  kindNummer         Int // 1, 2, 3 ... (HR waehlt manuell)
  kindGeschlecht     KindGeschlecht?
  geburtsurkunde     Boolean         @default(false)
  geburtsurkundePfad String?
  fruehgeburt        Boolean         @default(false)
  mehrlinge          Boolean         @default(false)

  // Status
  status ElternzeitStatus @default(ANGELEGT)

  // Magic-Link Tokens (Phase 1: nur Token 1 aktiv genutzt)
  antragTokenVorl       String?   @unique
  antragTokenVorlExpiry DateTime?
  antragTokenVorlUsedAt DateTime? // Single-Use Schutz
  antragTokenEndg       String?   @unique
  antragTokenEndgExpiry DateTime?
  antragTokenEndgUsedAt DateTime?

  // Antragsdaten
  antragVorlAm   DateTime?
  antragEndgAm   DateTime?
  genehmigungAm  DateTime?
  genehmigungVon String?
  ablehnungAm    DateTime?
  ablehnungGrund String?

  // Einrichtungsleiter (dynamisch, wie Verbeamtung)
  einrichtungsleiterName  String?
  einrichtungsleiterEmail String?

  // Einrichtungsleiter-Magic-Link (Phase 2 — Genehmigung via Token)
  leiterTokenEndg        String?   @unique
  leiterTokenEndgExpiry  DateTime?
  leiterTokenEndgUsedAt  DateTime?
  leiterGenehmigungAm    DateTime?
  leiterAblehnungGrund   String?

  // Bezirksregierung Detmold Tracking (Phase 2 — hier nur Felder)
  brSchreibenGeneriertAm DateTime?
  brSchreibenVersandtAm  DateTime?
  brAktenzeichen         String?
  brGenehmigungEingegAm  DateTime?

  // Mitarbeiter-Adresse (aus Formular, fuer Briefkopf)
  adresseStrasse String?
  adressePlz     String?
  adresseOrt     String?

  // Dienst-/Tarifbezeichnung (aus Formular)
  dienstbezeichnung String?
  schulnummer       String?

  // Gleichzeitige EZ beider Eltern
  gleichzeitigeEZ   Boolean @default(false)
  betreuungsabsicht String? // Freitext-Erklaerung

  // Sub-Modelle
  abschnitte     ElternzeitAbschnitt[]
  dokumente      ElternzeitDokument[]
  checklistItems ElternzeitChecklistItem[]
  notizen        ElternzeitNotiz[]
  fristen        ElternzeitFrist[]
  auditLogs      AuditLog[]                @relation("ElternzeitAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([employeeId])
  @@index([mutterschutzId])
  @@map("elternzeit_prozesse")
}

enum ElternzeitStatus {
  ANGELEGT
  ANTRAG_VORL_VERSANDT
  ANTRAG_VORL_EINGEREICHT
  VORLAEUFIG_GENEHMIGT
  VORLAEUFIG_ABGELEHNT
  ANTRAG_ENDG_VERSANDT
  ANTRAG_ENDG_EINGEREICHT
  GENEHMIGT
  AKTIV
  UNTERBROCHEN
  RUECKKEHR_GEPLANT
  BEENDET
  ABGELEHNT
}

enum Personalgruppe {
  TARIF_TV_L
  BEAMTER
  PLANSTELLENINHABER
}

enum Geschlecht {
  MUTTER
  VATER
}

enum KVTyp {
  GKV_PFLICHT
  GKV_FREIWILLIG
  PKV
}

enum KindGeschlecht {
  TOCHTER
  SOHN
}

model ElternzeitAbschnitt {
  id           String            @id @default(uuid())
  elternzeitId String
  elternzeit   ElternzeitProzess @relation(fields: [elternzeitId], references: [id], onDelete: Cascade)

  abschnittNr Int // 1, 2 oder 3
  von         DateTime
  bis         DateTime

  // Uebertragung auf 3.–8. Lebensjahr (§ 15 Abs. 2 BEEG)
  uebertragung3bis8 Boolean  @default(false)
  agZustimmung      Boolean? // null = noch offen, true = erteilt, false = abgelehnt

  // Teilzeit waehrend EZ
  teilzeit        Boolean @default(false)
  teilzeitStunden Float? // max. 32h

  // Feriensperrfrist (§ 11 FrUrlV NRW)
  ferienSperrfristWarnung Boolean @default(false)
  ferienBegruendung       String?

  createdAt DateTime @default(now())

  @@index([elternzeitId])
  @@map("elternzeit_abschnitte")
}

model ElternzeitDokument {
  id           String                @id @default(uuid())
  elternzeitId String
  elternzeit   ElternzeitProzess     @relation(fields: [elternzeitId], references: [id], onDelete: Cascade)
  dokumentTyp  ElternzeitDokumentTyp
  dateiname    String
  dateipfad    String
  mimeType     String?
  fileSize     Int?
  generiert    Boolean               @default(false) // true = vom System erzeugt

  hochgeladenAm  DateTime @default(now())
  hochgeladenVon String?

  @@index([elternzeitId])
  @@map("elternzeit_dokumente")
}

enum ElternzeitDokumentTyp {
  ANTRAG_VORLAEUFIG
  GENEHMIGUNG_VORLAEUFIG
  ANTRAG_ENDGUELTIG
  GEBURTSURKUNDE
  GENEHMIGUNG_ENDGUELTIG
  BR_DETMOLD_SCHREIBEN
  VBL_INFORMATIONSBRIEF
  AG_BESCHEINIGUNG_ELTERNGELD
  BEIHILFE_AENDERUNGSFORMULAR
  UNTERBRECHUNGSGENEHMIGUNG
  LOHNBESCHEINIGUNG_KK
  ABLEHNUNGSSCHREIBEN
  SONSTIGES
}

model ElternzeitChecklistItem {
  id           String            @id @default(uuid())
  elternzeitId String
  elternzeit   ElternzeitProzess @relation(fields: [elternzeitId], references: [id], onDelete: Cascade)

  titel          String
  beschreibung   String?
  logaHinweis    String? // ausfuehrlicher LOGA-Klickpfad
  erledigtAm     DateTime?
  erledigtVon    String?
  personalgruppe Personalgruppe? // null = alle Gruppen
  phase          ElternzeitPhase
  orderIndex     Int             @default(0)

  @@index([elternzeitId])
  @@map("elternzeit_checkliste")
}

enum ElternzeitPhase {
  ANTRAG
  GENEHMIGUNG
  EZ_AKTIV
  RUECKKEHR
}

model ElternzeitNotiz {
  id           String            @id @default(uuid())
  elternzeitId String
  elternzeit   ElternzeitProzess @relation(fields: [elternzeitId], references: [id], onDelete: Cascade)
  text         String
  erstelltVon  String
  createdAt    DateTime          @default(now())

  @@index([elternzeitId])
  @@map("elternzeit_notizen")
}

// =============================================
// NRW Schulferienkalender (pflegbar in Einstellungen, Phase 2)
// In Phase 1 nur Schema + Seed-Daten, kein UI
// =============================================
model SchulferienNRW {
  id          String    @id @default(uuid())
  bezeichnung String // "Sommerferien 2026"
  von         DateTime
  bis         DateTime
  ferienTyp   FerienTyp
  schuljahr   String // "2025/2026"
  aktiv       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([von, bis])
  @@map("schulferien_nrw")
}

enum FerienTyp {
  SOMMER // Sperrzone: 6 Wochen vor/nach
  SONSTIGE // Sperrzone: 2 Wochen vor/nach
}

// =============================================
// Fristen-System Elternzeit (Phase 2)
// Pro EZ-Vorgang werden bei Anlage / Zeitabschnitts-Erfassung
// alle relevanten Fristen automatisch generiert. Ein Cron-Job
// prueft taeglich Faelligkeit und triggert Webhooks.
// =============================================
model ElternzeitFrist {
  id           String            @id @default(uuid())
  elternzeitId String
  elternzeit   ElternzeitProzess @relation(fields: [elternzeitId], references: [id], onDelete: Cascade)

  fristTyp    ElternzeitFristTyp
  bezeichnung String // anzeigbarer Titel
  beschreibung String? // optionaler Hinweistext (z.B. Paragraf)
  faelligAm   DateTime // Stichtag

  // Erledigung
  erledigtAm  DateTime?
  erledigtVon String?
  erledigung  String? // Freitext (z.B. "BR-Genehmigung eingegangen am ...")

  // Cron-Tracking — verhindert Mehrfach-Webhooks pro Tag/Stufe
  letzteSeverity     ElternzeitFristSeverity?
  letzteWarnungAm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([elternzeitId])
  @@index([faelligAm])
  @@index([erledigtAm])
  @@map("elternzeit_fristen")
}

enum ElternzeitFristTyp {
  ANTRAGSFRIST_VORL // 7 Wochen vor Beginn (§ 16 Abs. 1 BEEG)
  TOKEN_VORL_EXPIRY // Magic Link Token 1 laeuft ab
  TOKEN_ENDG_EXPIRY // Magic Link Token 2 laeuft ab
  GEBURTSURKUNDE_NACHREICHUNG // 4 Wochen nach Geburt
  BR_GENEHMIGUNG // 8 Wochen nach BR-Schreiben (PSI/Beamte)
  BEIHILFE_AENDERUNG // 1 Monat nach EZ-Beginn (Beamte/PSI)
  RUECKKEHR_GESPRAECH // 6 Wochen vor Ende
  TEILZEIT_ANTRAG_PRUEFUNG // 4 Wochen Antwortfrist AG
  SONSTIGE
}

enum ElternzeitFristSeverity {
  INFO // mehr als 14 Tage bis Faelligkeit
  WARNING // 14-7 Tage
  URGENT // 6-0 Tage
  OVERDUE // ueberfaellig
}

// =============================================================================
// BEM — Betriebliches Eingliederungsmanagement (§ 167 Abs. 2 SGB IX)
// =============================================================================
// KERNPRINZIP "versiegelte Akte": invertiertes Zugriffsmodell. Niemand sieht
// BEM-Inhalte ausser explizit pro Fall freigegebene Personen (BemZugriff =
// Allowlist). Selbst SUPER_ADMIN/HR_LEITUNG duerfen Freigaben verwalten, aber
// Inhalte NICHT lesen. Strikt getrennt von der Personalakte (gesetzlich).
// Gesundheitsbezogene Freitexte werden mit BEM_ENCRYPTION_KEY verschluesselt.
// =============================================================================

model BemFall {
  id               String @id @default(uuid())
  displayId        String @unique // z.B. "BEM-2026-GYM-001"
  sequentialNumber Int

  // Verknuepfungen
  employeeId     String?
  employee       Employee?    @relation("EmployeeBem", fields: [employeeId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User         @relation("BemFallCreatedBy", fields: [createdById], references: [id])

  // Vom Mitarbeiter gewaehlte:r Ansprechpartner:in (E4-Erweiterung)
  ansprechpartnerId String?
  ansprechpartner   BemAnsprechpartner? @relation(fields: [ansprechpartnerId], references: [id])

  // Mitarbeiter-Daten (inline, fuer Briefkopf/Anzeige ohne Personalakten-Join)
  employeeFirstName  String
  employeeLastName   String
  employeeEmail      String?
  employeePersonalNr String?

  // Schwerbehinderung/Gleichstellung -> SBV-Beteiligung Pflicht (§ 167 / § 178 SGB IX)
  schwerbehindert Boolean @default(false)

  // Vom Mitarbeiter im Einwilligungs-Formular geaeusserter Wunsch nach einer
  // Vertrauensperson (BR/SBV/sonst.) zur Begleitung des BEM.
  vertrauenspersonWunsch Boolean @default(false)
  vertrauenspersonText   String?

  // E9: Erhoehter Diagnose-/Datenschutz. Wenn aktiv, werden die sensiblen
  // Freitexte (Gespraechs-Notizen, Massnahmen-Beschreibung) fuer freigegebene
  // BR/SBV ausgeblendet — sichtbar nur fuer Beauftragte/Vertretung.
  diagnoseSchutz Boolean @default(false)

  // Prozess
  status      BemStatus     @default(ANGELEGT)
  eingangsweg BemEingangsweg @default(DIGITAL)

  // Zeitstempel des Verfahrens
  anlassFehlzeitenAb DateTime? // Beginn der relevanten Fehlzeiten
  einladungAm        DateTime?
  datenschutzAm      DateTime?
  erstgespraechAm    DateTime?
  beendetAm          DateTime?
  beendigungsgrund   String?
  ergebnis           BemErgebnis? // Abschluss-Ergebnis (nur bei ABGESCHLOSSEN)

  // Aufbewahrung / Loeschung (Crypto-Shredding)
  aufbewahrungBis DateTime? // beendetAm + bemAufbewahrungJahre
  geloeschtAm     DateTime?

  // Sub-Modelle
  zugriffe      BemZugriff[]
  gespraeche    BemGespraech[]
  massnahmen    BemMassnahme[]
  einwilligungen BemEinwilligung[]
  dokumente     BemDokument[]
  fristen       BemFrist[]
  kommunikation BemKommunikation[]
  auditLogs     AuditLog[]         @relation("BemAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([employeeId])
  @@map("bem_faelle")
}

enum BemStatus {
  ANGELEGT
  EINLADUNG_VERSENDET
  EINWILLIGUNG_ERTEILT
  EINWILLIGUNG_ABGELEHNT
  ERSTGESPRAECH
  MASSNAHMEN_LAUFEN
  ABGESCHLOSSEN
  ABGEBROCHEN
  AUFBEWAHRUNG
  GELOESCHT
}

enum BemEingangsweg {
  DIGITAL // Magic-Link-Formular
  PAPIER // ausgedruckt + Scan-Upload
}

// Die "Versiegelung": Allowlist, wer diesen Fall sehen/bearbeiten darf.
model BemZugriff {
  id        String          @id @default(uuid())
  bemFallId String
  bemFall   BemFall         @relation(fields: [bemFallId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("BemZugriffUser", fields: [userId], references: [id])
  rolle     BemZugriffRolle @default(BEAUFTRAGTE)

  grantedById String?
  grantedBy   User?    @relation("BemZugriffGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime @default(now())
  revokedAt   DateTime? // null = aktiv

  @@index([bemFallId])
  @@index([userId])
  @@index([revokedAt])
  @@map("bem_zugriffe")
}

enum BemZugriffRolle {
  BEAUFTRAGTE // BEM-Beauftragte:r (fuehrt das Verfahren)
  VERTRETUNG
  BR // Betriebsrat
  SBV // Schwerbehindertenvertretung
}

model BemGespraech {
  id        String          @id @default(uuid())
  bemFallId String
  bemFall   BemFall         @relation(fields: [bemFallId], references: [id], onDelete: Cascade)
  typ       BemGespraechTyp
  datum     DateTime?
  ort       String?
  teilnehmer Json? // Liste { name, rolle }
  notizen   String? // VERSCHLUESSELT (BEM_ENCRYPTION_KEY)
  checkliste Json? // abgehakte Punkte aus CREDO-Vorlage
  naechsterTermin DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bemFallId])
  @@map("bem_gespraeche")
}

enum BemGespraechTyp {
  ERSTGESPRAECH
  FOLGEGESPRAECH
  GEDAECHTNISPROTOKOLL
}

model BemMassnahme {
  id        String               @id @default(uuid())
  bemFallId String
  bemFall   BemFall              @relation(fields: [bemFallId], references: [id], onDelete: Cascade)
  kategorie BemMassnahmeKategorie
  beschreibung String // VERSCHLUESSELT (BEM_ENCRYPTION_KEY)
  zustaendig   String?
  frist        DateTime?
  status       BemMassnahmeStatus @default(OFFEN)
  evaluationAm DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bemFallId])
  @@map("bem_massnahmen")
}

enum BemMassnahmeKategorie {
  TECHNISCH
  ORGANISATORISCH
  PERSONENBEZOGEN
  WIEDEREINGLIEDERUNG // stufenweise Wiedereingliederung (Hamburger Modell)
}

enum BemErgebnis {
  ERFOLGREICH
  TEILWEISE
  KEIN_ERFOLG
  KEINE_MASSNAHMEN_NOETIG
}

enum BemMassnahmeStatus {
  OFFEN
  LAEUFT
  UMGESETZT
  VERWORFEN
}

model BemEinwilligung {
  id        String                @id @default(uuid())
  bemFallId String
  bemFall   BemFall               @relation(fields: [bemFallId], references: [id], onDelete: Cascade)
  art       BemEinwilligungArt
  status    BemEinwilligungStatus @default(OFFEN)

  // Magic-Link (digitaler Weg)
  token       String?   @unique
  tokenExpiry DateTime?
  tokenUsedAt DateTime?

  // Nachweis der Erteilung/Ablehnung/Widerruf
  signedAt    DateTime?
  signedIp    String?
  signedName  String?
  widerrufAm  DateTime?
  dokumentHash String? // Hash der unterschriebenen Erklaerung

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bemFallId])
  @@map("bem_einwilligungen")
}

enum BemEinwilligungArt {
  DATENSCHUTZ
  DURCHFUEHRUNG
  BR
  SBV
}

enum BemEinwilligungStatus {
  OFFEN
  ERTEILT
  ABGELEHNT
  WIDERRUFEN
}

model BemDokument {
  id        String          @id @default(uuid())
  bemFallId String
  bemFall   BemFall         @relation(fields: [bemFallId], references: [id], onDelete: Cascade)
  typ       BemDokumentTyp
  ablage    BemDokumentAblage @default(NUR_BEM)
  quelle    BemDokumentQuelle @default(GENERIERT)

  dateiname String
  dateipfad String
  mimeType  String?
  fileSize  Int?
  hash      String? // SHA256

  createdById String?
  createdAt   DateTime @default(now())

  @@index([bemFallId])
  @@map("bem_dokumente")
}

enum BemDokumentTyp {
  EINLADUNG
  DATENSCHUTZVEREINBARUNG
  ERSTGESPRAECH_PROTOKOLL
  FOLGEGESPRAECH_PROTOKOLL
  GEDAECHTNISPROTOKOLL
  MASSNAHMENPLAN
  ABSCHLUSSERKLAERUNG
  ABBRUCHERKLAERUNG
  BEENDIGUNGSERKLAERUNG
  ATTEST // AU / aerztliches Attest / mitgebrachte Unterlagen (Upload)
  GESAMT_EXPORT // Mitarbeiter-Gesamtexport (DSGVO Art. 15)
  SONSTIGES
}

// Aktentrennung (gesetzlich vorgeschrieben):
// - NUR_BEM: bleibt ausschliesslich in der BEM-Akte
// - KOPIE_PERSONALAKTE: bereinigte Kopie (ohne med. Details) -> Personalakte
// - ORIGINAL_PERSONALAKTE: Original in Personalakte (Kuendigungsschutz) + Kopie BEM
enum BemDokumentAblage {
  NUR_BEM
  KOPIE_PERSONALAKTE
  ORIGINAL_PERSONALAKTE
}

enum BemDokumentQuelle {
  GENERIERT // aus Vorlagenbibliothek (E0)
  UPLOAD // Papier-Scan
}

model BemFrist {
  id        String      @id @default(uuid())
  bemFallId String
  bemFall   BemFall     @relation(fields: [bemFallId], references: [id], onDelete: Cascade)
  typ       BemFristTyp
  bezeichnung String
  beschreibung String?
  faelligAm  DateTime

  erledigtAm  DateTime?
  erledigtVon String?

  // Cron-Tracking — verhindert Mehrfach-Webhooks pro Tag/Stufe
  letzteSeverity  BemFristSeverity?
  letzteWarnungAm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bemFallId])
  @@index([faelligAm])
  @@index([erledigtAm])
  @@map("bem_fristen")
}

enum BemFristTyp {
  EINLADUNG
  EINWILLIGUNG
  ERSTGESPRAECH
  FOLGEGESPRAECH
  EVALUATION
  AUFBEWAHRUNGSENDE
  SONSTIGE
}

enum BemFristSeverity {
  INFO
  WARNING
  URGENT
  OVERDUE
}

// =============================================
// Versand-/Kommunikationsprotokoll (NFR 0a)
// Prüfungssicherer Nachweis: jede ausgehende Mail + jeder generierte Brief.
// Eintrag wird ERST nach erfolgreichem Versand als GESENDET geschrieben
// (Fehlversuche als FEHLGESCHLAGEN), damit das Protokoll wahrheitsgemaess bleibt.
// =============================================
model BemKommunikation {
  id        String                 @id @default(uuid())
  bemFallId String
  bemFall   BemFall                @relation(fields: [bemFallId], references: [id], onDelete: Cascade)
  kanal     BemKommunikationKanal
  status    BemKommunikationStatus @default(GESENDET)

  empfaenger String // E-Mail-Adresse oder Name (bei BRIEF)
  betreff    String?
  dokumentId String? // optionaler Bezug zu BemDokument
  dokumentHash String? // SHA256 des versendeten/erzeugten Dokuments
  messageId  String? // SMTP-Message-ID = Zustellnachweis
  fehlertext String? // bei FEHLGESCHLAGEN
  ipAddress  String?

  gesendetById String?
  gesendetBy   User?   @relation("BemKommunikationSentBy", fields: [gesendetById], references: [id])
  gesendetAm   DateTime @default(now())

  @@index([bemFallId])
  @@index([gesendetAm])
  @@map("bem_kommunikation")
}

enum BemKommunikationKanal {
  EMAIL
  BRIEF // generierter/ausgedruckter Brief (Word/PDF)
}

enum BemKommunikationStatus {
  GESENDET
  FEHLGESCHLAGEN
  GENERIERT // Brief erzeugt, aber (noch) nicht versendet
}

// =============================================
// BEM-Ansprechpartner:innen (pro Mandant pflegbar)
// Die/der Beschaeftigte waehlt im Einwilligungs-Formular eine:n Ansprechpartner:in;
// diese:r wird per Mail informiert. Konfiguration unter Mandanten-Einstellungen.
// =============================================
model BemAnsprechpartner {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  email    String
  funktion String? // z.B. "BEM-Beauftragte", "Betriebsarzt", "Schwerbehindertenvertretung"
  isActive Boolean @default(true)
  orderIndex Int   @default(0)

  faelle BemFall[] // Faelle, in denen diese:r Ansprechpartner:in gewaehlt wurde

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("bem_ansprechpartner")
}
