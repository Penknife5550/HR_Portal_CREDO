// =============================================
// Offboarding-Vorgang (ein Vorgang pro Austritt)
// =============================================
model OffboardingProcess {
  id               String @id @default(uuid())
  displayId        String @unique // z.B. "OFF-2026-GYM-001"
  sequentialNumber Int // Laufende Nummer fuer displayId

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Mitarbeiter-Daten (inline, für Abwärtskompatibilität)
  employeeEmail        String
  employeeFirstName    String
  employeeLastName     String
  employeePersonalNr   String?
  employeePrivateEmail String?

  // Verknüpfung zur zentralen Personalakte (optional, wird schrittweise befüllt)
  employeeId String?
  employee   Employee? @relation("EmployeeOffboardings", fields: [employeeId], references: [id])

  // Link zum Onboarding (optional)
  onboardingId String?

  // Austrittsgrund
  exitType   ExitType
  exitReason String?

  // Termine
  noticeDate      DateTime?
  lastWorkingDay  DateTime
  contractEndDate DateTime?
  noticePeriodEnd DateTime?

  // Status
  status OffboardingStatus @default(INITIATED)

  // Initiierung
  initiatedById String
  initiatedBy   User      @relation("OffboardingInitiator", fields: [initiatedById], references: [id])
  initiatedAt   DateTime  @default(now())
  completedAt   DateTime?

  // DSGVO
  dataRetentionDate DateTime?

  // Relationen
  exitData        OffboardingExitData?
  returnItems     ReturnItem[]
  documents       OffboardingDocument[]
  checklistItems  OffboardingChecklistItem[]
  notes           OffboardingNote[]
  departmentLinks OffboardingDepartmentLink[]
  auditLogs       AuditLog[]                  @relation("OffboardingAuditLogs")

  // Phase 2
  exitInterview    ExitInterview?
  zeugnisBewertung ZeugnisBewertung?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([displayId])
  @@map("offboarding_processes")
}

// =============================================
// Austrittsdaten (1:1 zum Offboarding)
// =============================================
model OffboardingExitData {
  id            String             @id @default(uuid())
  offboardingId String             @unique
  offboarding   OffboardingProcess @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  // Beschaeftigungsart
  employmentType String? // z.B. "ANGESTELLT", "BEAMTET", "MINIJOB"
  tarifvertrag   String?
  entgeltgruppe  String?
  isBefristet    Boolean @default(false)

  // Urlaub & Ueberstunden
  remainingVacationDays Float?
  vacationPayout        Float?
  overtimeHours         Float?
  overtimePayout        Float?

  // Abfindung (verschluesselt)
  severancePay String?

  // Zeugnis
  certificateType   String?
  certificateStatus String  @default("PENDING")

  // Sozialversicherung
  svDeregistrationDone Boolean   @default(false)
  svDeregistrationDate DateTime?

  // Arbeitsbescheinigung
  employmentCertDone Boolean   @default(false)
  employmentCertDate DateTime?

  // Wettbewerbsverbot
  nonCompeteClause Boolean @default(false)

  // Wissenstransfer
  knowledgeTransferPlan Boolean @default(false)
  successorName         String?
  handoverDocComplete   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offboarding_exit_data")
}

// =============================================
