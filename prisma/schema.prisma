// =============================================
// CREDO HR-Portal - Datenmodell
// PostgreSQL 16 + Prisma 6
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// Einrichtung / Mandant (16 Mandanten bei CREDO)
// =============================================
model Organization {
  id            String           @id @default(uuid())
  mandantNumber String           @unique // z.B. "712", "737", "742"
  name          String // z.B. "Gymnasium", "Kita Minden"
  shortName     String? // z.B. "GYM", "GSM"
  type          OrganizationType
  isActive      Boolean          @default(true)

  // =============================================
  // Elternzeit / Mutterschutz — Mandanten-Konfiguration (Phase 2)
  // Pro Mandant konfigurierbar fuer Briefvorlagen und Standard-Workflows.
  // =============================================
  // Geschaeftsfuehrung / Unterschrift fuer endg. Genehmigungen
  ezGfFirstName     String? // Vorname Geschaeftsfuehrer/in
  ezGfLastName      String? // Nachname Geschaeftsfuehrer/in
  ezGfTitle         String? // z.B. "Geschaeftsfuehrer", "Schulleiter/in"
  ezSignaturePath   String? // optional: Pfad zu Unterschrifts-PNG (uploads/signatures/...)

  // Standard-Einrichtungsleiter (Phase-2-Workflow)
  ezDefaultLeiterFirstName String?
  ezDefaultLeiterLastName  String?
  ezDefaultLeiterEmail     String?

  // Bezirksregierung Detmold Kontakt (PSI/Beamte)
  ezBrDetmoldName        String?
  ezBrDetmoldEmail       String?
  ezBrDetmoldPhone       String?
  ezBrDetmoldAktenPrefix String? // optional: Aktenzeichen-Prefix

  // Token-Konfiguration
  ezTokenValidityDays Int @default(30)

  // =============================================
  // Datenschutz — Verantwortliche Stelle (DSGVO, pro Mandant konfigurierbar)
  // Wird im Personalfragebogen (DSGVO-Text) und als Brief-Platzhalter genutzt.
  // Faellt auf den globalen Default zurueck, wenn nicht gesetzt.
  // =============================================
  dsgvoVerantwortlicheName    String? // z.B. "Christlicher Schulverein Minden e.V."
  dsgvoVerantwortlicheStrasse String? // z.B. "Kingsleyallee 6"
  dsgvoVerantwortlichePlz     String? // z.B. "32425"
  dsgvoVerantwortlicheOrt     String? // z.B. "Minden"

  // =============================================
  // BEM (Betriebliches Eingliederungsmanagement, § 167 SGB IX)
  // Standard-Beauftragte pro Mandant (ueberschreibt globalen Default).
  // Bei CREDO i.d.R. fuer alle 16 Mandanten dieselben (Elena/Danny Bergen).
  // =============================================
  bemBeauftragte1Name  String?
  bemBeauftragte1Email String?
  bemBeauftragte2Name  String?
  bemBeauftragte2Email String?
  bemAufbewahrungJahre Int     @default(4) // Aufbewahrungsfrist nach Beendigung

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  onboardings           OnboardingProcess[]
  offboardings          OffboardingProcess[]
  departmentConfigs     DepartmentConfig[]
  employments           Employment[]
  userAssignments       UserOrgAssignment[]
  civilServiceProcesses CivilServiceProcess[]
  beurteilungTemplates  BeurteilungTemplate[]
  mutterschutzProzesse  MutterschutzProzess[]
  elternzeitProzesse    ElternzeitProzess[]
  documentTemplates     DocumentTemplate[]
  generatedDocuments    GeneratedDocument[]
  bemFaelle             BemFall[]
  bemAnsprechpartner    BemAnsprechpartner[]

  @@map("organizations")
}

// =============================================
// Mitarbeiter (zentrale Personalakte)
// Ein Mitarbeiter existiert genau einmal, auch bei Mehrfacheinstellungen.
// Stammdaten koennen via n8n aus LOGA importiert werden.
// =============================================
model Employee {
  id             String    @id @default(uuid())
  personalNumber String?   @unique // Personalnummer aus LOGA
  firstName      String
  lastName       String
  email          String? // Dienst-E-Mail
  privateEmail   String? // Private E-Mail (fuer Exit-Interview)
  dateOfBirth    DateTime?
  phone          String?

  // Import-Tracking
  importSource String? // z.B. "LOGA", "MANUELL"
  importedAt   DateTime?
  lastSyncAt   DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationen
  employments           Employment[]
  onboardings           OnboardingProcess[]   @relation("EmployeeOnboardings")
  offboardings          OffboardingProcess[]  @relation("EmployeeOffboardings")
  civilServiceProcesses CivilServiceProcess[] @relation("EmployeeCivilService")
  mutterschutzProzesse  MutterschutzProzess[] @relation("EmployeeMutterschutz")
  elternzeitProzesse    ElternzeitProzess[]   @relation("EmployeeElternzeit")
  bemFaelle             BemFall[]             @relation("EmployeeBem")

  @@index([personalNumber])
  @@index([lastName, firstName])
  @@map("employees")
}

// =============================================
// Anstellung (1 Mitarbeiter kann n Anstellungen haben)
// z.B. Lehrkraft am Gymnasium + Nachmittagsbetreuung an der Kita
// =============================================
model Employment {
  id             String       @id @default(uuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  position         String? // z.B. "Lehrkraft", "Erzieher/in"
  department       String? // z.B. "Grundschule", "Verwaltung"
  contractType     ContractType?
  workingHoursWeek Float? // z.B. 39.0, 20.0
  startDate        DateTime?
  endDate          DateTime? // null = unbefristet
  mandantNumber    String? // LOGA Mandantennummer

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([organizationId])
  @@map("employments")
}

enum ContractType {
  UNBEFRISTET
  BEFRISTET
  BEAMTER
  MINIJOB
  EHRENAMT
  PRAKTIKUM
}

// =============================================
// User-Org-Zuweisung (1 User kann n Mandanten sehen)
// Einrichtungsleitung sieht nur zugewiesene Mandanten
// =============================================
model UserOrgAssignment {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("user_org_assignments")
}

enum OrganizationType {
  GYMNASIUM
  GESAMTSCHULE
  GRUNDSCHULE
  BERUFSKOLLEG
  KITA
  VERWALTUNG
  GMBH
  VEREIN
}

// =============================================
// Onboarding-Vorgang (ein Vorgang pro Einstellung)
// =============================================
model OnboardingProcess {
  id               String       @id @default(uuid())
  displayId        String?      @unique // z.B. "2026-GYM-001"
  sequentialNumber Int? // Laufende Nummer fuer displayId
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])

  // Neuer Mitarbeiter
  email     String
  firstName String?
  lastName  String?

  // Verknüpfung zur zentralen Personalakte (optional)
  employeeId String?
  employee   Employee? @relation("EmployeeOnboardings", fields: [employeeId], references: [id])

  // Magic Link fuer MA (Personalfragebogen)
  token          String   @unique @default(uuid())
  tokenExpiresAt DateTime

  // Magic Link fuer Vorgesetzten (Einstellungsmodalitaeten)
  supervisorEmail          String?
  supervisorToken          String?   @unique
  supervisorTokenExpiresAt DateTime?

  // Prozesstyp & Status
  processType       ProcessType       @default(EINSTELLUNG)
  status            OnboardingStatus  @default(INVITED)
  questionnaireType QuestionnaireType @default(STANDARD)

  // Checkliste
  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])
  checklistItems      ChecklistItem[]

  // Fragebogen-Versionierung (Vorschlag 5: Snapshot bei Erstellung)
  formTemplateVersion  Int? // Welche Template-Version war aktiv
  formTemplateSnapshot Json? // Kompletter stepsConfig-Snapshot

  // Tracking
  invitedById           String?
  invitedBy             User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedAt             DateTime  @default(now())
  submittedAt           DateTime?
  supervisorSubmittedAt DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  completedAt           DateTime?

  // Erinnerungen
  lastEmployeeReminderAt   DateTime? // Letzte Erinnerung an Mitarbeiter
  lastSupervisorReminderAt DateTime? // Letzte Erinnerung an Vorgesetzten

  // Relationen
  personalData   PersonalData?
  supervisorData SupervisorData?
  documents      Document[]
  notes          OnboardingNote[]
  auditLogs      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([email])
  @@index([displayId])
  @@map("onboarding_processes")
}

enum OnboardingStatus {
  INVITED // Link versendet, noch nicht geoeffnet
  IN_PROGRESS // MA hat angefangen auszufuellen
  SUBMITTED // MA hat Fragebogen abgeschickt
  SUPERVISOR_PENDING // Warte auf Vorgesetzten-Eingabe
  SUPERVISOR_SUBMITTED // Vorgesetzter hat ausgefuellt
  REVIEWED // HR hat geprueft
  COMPLETED // Alles erledigt, Daten exportiert
  EXPIRED // Link abgelaufen
}

// =============================================
// Prozesstyp (zukunftssicher fuer weitere HR-Vorgaenge)
// =============================================
enum ProcessType {
  EINSTELLUNG // Neueinstellung (bisheriges Onboarding)
  VERBEAMTUNG // Verbeamtungsprozess
  VERTRAGSAENDERUNG // Vertragsaenderung (Stunden, Entgeltgruppe etc.)
  KUENDIGUNG // Austritt / Kuendigung
}

enum QuestionnaireType {
  STANDARD // Angestellte (TV-L)
  BEAMTE // Planstelleninhaber
  ERZIEHER // Kita-Personal (TV-L S)
  MINIJOB // Geringfuegig Beschaeftigte
  EHRENAMT // Ehrenamtliche
}

// =============================================
// Personalfragebogen-Daten (vom neuen Mitarbeiter ausgefuellt)
// =============================================
model PersonalData {
  id           String            @id @default(uuid())
  onboardingId String            @unique
  onboarding   OnboardingProcess @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  // -- Persoenliche Angaben --
  salutation       String? // "Herr", "Frau", "Divers"
  title            String? // "Dr.", "Prof." etc.
  firstName        String?
  lastName         String?
  birthName        String? // Geburtsname
  birthDate        DateTime?
  birthPlace       String?
  birthCountry     String?   @default("Deutschland")
  nationality      String?   @default("deutsch")
  maritalStatus    String? // "ledig", "verheiratet", "geschieden", "verwitwet"
  severelyDisabled Boolean?  @default(false)
  disabilityDegree Int?

  // -- Adresse --
  street       String?
  houseNumber  String?
  zipCode      String?
  city         String?
  country      String? @default("Deutschland")
  phone        String?
  mobile       String?
  emailPrivate String?

  // -- Bankverbindung --
  iban          String?
  bic           String?
  bankName      String?
  accountHolder String?

  // -- Sozialversicherung --
  socialSecurityNumber String?
  healthInsuranceName  String?
  healthInsuranceType  String? // "gesetzlich", "privat"
  parentStatus         Boolean? // Elterneigenschaft fuer PV-Zuschlag

  // -- Steuer --
  taxId          String?
  taxClass       String? // "I", "II", "III", "IV", "V", "VI"
  taxAllowance   Float? // Jaehrlicher Freibetrag
  childAllowance Float? // Kinderfreibetrag
  religion       String? // Fuer Kirchensteuer: "ev", "rk", "keine" etc.

  // -- Bildung & Beruf --
  highestSchoolDegree       String? // "ohne_schulabschluss", "hauptschulabschluss", "mittlere_reife", "abitur_fachabitur", "sonstiges"
  highestProfessionalDegree String? // "ohne_berufsausbildung", "anerkannte_berufsausbildung", etc.

  // -- Beamten-Zusatzfelder (Legacy) --
  isBeamter                Boolean   @default(false)
  besoldungsgruppe         String?
  laufbahngruppe           String?
  dienstzeitBeginn         DateTime?
  amtsbezeichnung          String?
  verfassungstreuePruefung Boolean?

  // -- Sonstiges --
  hasOtherEmployment Boolean? @default(false)
  otherEmployerName  String?
  otherWeeklyHours   Float?
  employerType       String? // "hauptarbeitgeber", "nebenarbeitgeber", "nein"
  hasMinijob         Boolean? @default(false)
  minijobRvBefreiung Boolean? @default(false)

  // -- Masernschutz --
  bornAfter1971        Boolean?
  masernschutzProvided Boolean?

  // -- Formular-Meta --
  currentStep     Int       @default(0)
  isComplete      Boolean   @default(false)
  dsgvoAccepted   Boolean   @default(false)
  dsgvoAcceptedAt DateTime?

  // Kinder
  children Child[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personal_data")
}

// =============================================
// Kinder des Mitarbeiters
// =============================================
model Child {
  id             String       @id @default(uuid())
  personalDataId String
  personalData   PersonalData @relation(fields: [personalDataId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  birthDate    DateTime
  taxAllowance Boolean  @default(false) // Kinderfreibetrag
  orderIndex   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("children")
}

// =============================================
// Einstellungsmodalitaeten (vom Vorgesetzten ausgefuellt)
// =============================================
model SupervisorData {
  id           String            @id @default(uuid())
  onboardingId String            @unique
  onboarding   OnboardingProcess @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  // -- Betriebsstaette --
  betriebsstaette String?

  // -- Stellenbeschreibung (wird in Arbeitsvertrag uebernommen!) --
  stellenbeschreibung String?

  // -- Vertragsdaten --
  vertragsbeginn      DateTime?
  befristet           Boolean?
  vertragsende        DateTime?
  befristungSachgrund String?

  // -- Vertragsumfang --
  vollzeit      Boolean? @default(true)
  wochenstunden Float?
  tageProWoche  Int?

  // -- Arbeitgeber-Zuordnung (CREDO-Besonderheit: Haupt-/Nebenarbeitgeber) --
  hauptarbeitgeberId      String? // Mandantennummer des Hauptarbeitgebers
  hauptarbeitgeberStunden Float?
  nebenarbeitgeberId      String? // Mandantennummer des Nebenarbeitgebers (optional)
  nebenarbeitgeberStunden Float?

  // -- Vertragsart --
  svPflichtig Boolean? @default(true)
  minijob     Boolean? @default(false)
  ehrenamt    Boolean? @default(false)

  // -- Kostenstelle --
  kostenstelle       String?
  kostenstelleAnteil Float? // Prozentuale Aufteilung

  // -- Probezeit --
  probezeit       Boolean? @default(true)
  probezeitMonate Int?     @default(6)

  // -- Verguetung --
  verguetungsmodell   String? // "TV_L", "TV_L_S", "HAUSTARIF", "SONSTIGES"
  entgeltgruppe       String? // z.B. "E11", "S8a"
  stufe               String? // z.B. "3"
  festgehalt          Float?
  stundenlohn         Float?
  bemerkungVerguetung String?

  // -- Jahressonderzahlung --
  jahressonderzahlung  Boolean? @default(true)
  sonderzahlungProzent Float?

  // -- Sachbezuege & Zulagen --
  sachbezuege       Boolean? @default(false)
  sachbezuegeBetrag Float?
  zulage            Boolean? @default(false)
  zulageBetrag      Float?

  // -- Urlaubsanspruch --
  urlaubstageProJahr Int? @default(30)

  // -- Masernschutz (fuer MA mit Kinderkontakt) --
  masernschutzErforderlich     Boolean? @default(false)
  masernschutzVorArbeitsbeginn Boolean?

  // -- Zeiterfassung --
  zeiterfassung Boolean? @default(true)

  // -- Zusaetzliche Vereinbarungen --
  zusatzvereinbarungen String?

  // -- Meta --
  currentStep Int     @default(0)
  isComplete  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("supervisor_data")
}

// =============================================
// Hochgeladene Dokumente
// =============================================
model Document {
  id           String            @id @default(uuid())
  onboardingId String
  onboarding   OnboardingProcess @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  type            DocumentType
  fileName        String
  filePath        String
  fileSize        Int // in Bytes
  mimeType        String
  status          DocumentStatus @default(UPLOADED)
  rejectionReason String?

  uploadedAt   DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())

  @@index([onboardingId])
  @@map("documents")
}

enum DocumentType {
  ARBEITSVERTRAG
  FUEHRUNGSZEUGNIS
  KK_BESCHEINIGUNG
  GEBURTSURKUNDE_EIGEN
  GEBURTSURKUNDE_KIND
  SV_AUSWEIS
  ZEUGNIS
  ABSCHLUSSZEUGNIS
  MASERNSCHUTZ
  INFEKTIONSSCHUTZ
  RV_BEFREIUNG
  SB_AUSWEIS
  VL_VERTRAG
  BAV_VERTRAG
  SONSTIGES
}

enum DocumentStatus {
  UPLOADED
  REVIEWED
  APPROVED
  REJECTED
}

// =============================================
// Portal-Benutzer (HR-Team)
// =============================================
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(HR_SACHBEARBEITER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // BEM (Phase 1): Kennzeichnung als BEM-Beauftragte:r.
  // Darf BEM-Faelle anlegen und erhaelt bei Anlage Auto-Freigabe (BemZugriff).
  // Interne Nutzer behalten ihre Rolle + dieses Flag; EXTERNE Beauftragte
  // bekommen die eigene Rolle BEM_BEAUFTRAGTER (E7).
  isBemBeauftragte Boolean @default(false)

  // E7: Externe BEM-Beauftragte richten ihr Passwort ueber einen einmaligen,
  // zeitlich begrenzten Setup-Link selbst ein (es wird nur der SHA-256-Hash
  // des Tokens gespeichert — analog zu den Magic-Links).
  passwortSetupTokenHash String?
  passwortSetupExpiresAt DateTime?

  // Org-Zuweisungen (welche Mandanten darf dieser User sehen?)
  // SUPER_ADMIN + HR_LEITUNG sehen alles, bei anderen gelten die Zuweisungen
  orgAssignments UserOrgAssignment[]

  // Relationen
  invitedOnboardings      OnboardingProcess[] @relation("InvitedBy")
  reviewedOnboardings     OnboardingProcess[] @relation("ReviewedBy")
  reviewedDocuments       Document[]
  completedChecklistItems ChecklistItem[]     @relation("CompletedChecklistItems")
  onboardingNotes         OnboardingNote[]    @relation("NoteCreatedBy")
  auditLogs               AuditLog[]

  // Offboarding-Relationen
  initiatedOffboardings OffboardingProcess[] @relation("OffboardingInitiator")
  offboardingNotes      OffboardingNote[]    @relation("OffboardingNoteAuthor")

  // Phase 2: Zeugnis-Review
  reviewedZeugnisse  ZeugnisBewertung[] @relation("ZeugnisReviewer")
  finalizedZeugnisse ZeugnisBewertung[] @relation("ZeugnisFinalizier")

  // Verbeamtung
  initiatedCivilService CivilServiceProcess[] @relation("CivilServiceInitiator")

  // Mutterschutz & Elternzeit
  initiatedMutterschutz MutterschutzProzess[] @relation("MutterschutzInitiator")
  initiatedElternzeit   ElternzeitProzess[]   @relation("ElternzeitInitiator")

  // Vorlagenbibliothek (E0)
  createdDocumentTemplates  DocumentTemplate[]
  createdGeneratedDocuments GeneratedDocument[]

  // BEM (E1)
  createdBemFaelle      BemFall[]          @relation("BemFallCreatedBy")
  bemZugriffe           BemZugriff[]       @relation("BemZugriffUser")
  grantedBemZugriffe    BemZugriff[]       @relation("BemZugriffGrantedBy")
  bemKommunikationen    BemKommunikation[] @relation("BemKommunikationSentBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  HR_LEITUNG
  HR_SACHBEARBEITER
  EINRICHTUNGSLEITUNG
  VORGESETZTER
  BEM_BEAUFTRAGTER // E7: externe:r BEM-Beauftragte:r, sieht ausschliesslich BEM
}

// =============================================
// Audit-Log (wer hat wann was geaendert)
// =============================================
model AuditLog {
  id             String               @id @default(uuid())
  userId         String?
  user           User?                @relation(fields: [userId], references: [id])
  onboardingId   String?
  onboarding     OnboardingProcess?   @relation(fields: [onboardingId], references: [id])
  offboardingId  String?
  offboarding    OffboardingProcess?  @relation("OffboardingAuditLogs", fields: [offboardingId], references: [id])
  civilServiceId String?
  civilService   CivilServiceProcess? @relation("CivilServiceAuditLogs", fields: [civilServiceId], references: [id])
  mutterschutzId String?
  mutterschutz   MutterschutzProzess? @relation("MutterschutzAuditLogs", fields: [mutterschutzId], references: [id])
  elternzeitId   String?
  elternzeit     ElternzeitProzess?   @relation("ElternzeitAuditLogs", fields: [elternzeitId], references: [id])
  bemFallId      String?
  bemFall        BemFall?             @relation("BemAuditLogs", fields: [bemFallId], references: [id])
  processType    String? // "ONBOARDING", "OFFBOARDING", "CIVIL_SERVICE", "MUTTERSCHUTZ", "ELTERNZEIT", "BEM"

  action    String // z.B. "ONBOARDING_CREATED", "QUESTIONNAIRE_SUBMITTED"
  details   Json? // Zusaetzliche Infos
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([onboardingId])
  @@index([offboardingId])
  @@index([civilServiceId])
  @@index([mutterschutzId])
  @@index([elternzeitId])
  @@index([bemFallId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================
// Zentrale Vorlagenbibliothek (E0, moduluebergreifend)
// Word-Vorlagen (.docx) mit Platzhaltern -> Ausgabe Word / PDF / Mail.
// scope: GLOBAL (organizationId == null) oder MANDANT (organizationId gesetzt).
// Wird moduluebergreifend genutzt (BEM, Onboarding, ...).
// =============================================
model DocumentTemplate {
  id           String  @id @default(uuid())
  name         String // Anzeigename, z.B. "BEM-Einladung"
  description  String?
  modul        String  @default("ALLGEMEIN") // "ALLGEMEIN" | "BEM" | "ONBOARDING" | ...
  dateipfad    String // Pfad zur gespeicherten .docx (uploads/brief-vorlagen/...)
  originalName String // urspruenglicher Dateiname beim Upload
  fileSize     Int // Bytes
  hash         String // SHA-256 der .docx
  platzhalter  Json    @default("[]") // ["vorname","nachname", ...] aus der Datei extrahiert

  // Scope: null = global, sonst Mandanten-spezifischer Override
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  generatedDocuments GeneratedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modul])
  @@index([organizationId])
  @@index([isActive])
  @@map("document_templates")
}

// Protokoll erzeugter Dokumente (Audit + Wiederfinden in DMS).
model GeneratedDocument {
  id         String            @id @default(uuid())
  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name  String // Anzeigename des erzeugten Dokuments
  modul String  @default("ALLGEMEIN")
  refId String? // Bezug, z.B. bemFallId / onboardingId / employeeId

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  pfadDocx            String?
  pfadPdf             String?
  hash                String?
  missingPlaceholders String[] @default([]) // nicht befuellte Platzhalter (Warnung)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([templateId])
  @@index([modul])
  @@index([refId])
  @@index([organizationId])
  @@map("generated_documents")
}

// =============================================
// Vorgang-Notizen (allgemeine Notizen pro Onboarding)
// =============================================
model OnboardingNote {
  id           String            @id @default(uuid())
  onboardingId String
  onboarding   OnboardingProcess @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  content     String
  createdById String
  createdBy   User   @relation("NoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingId])
  @@map("onboarding_notes")
}

// =============================================
// Checklisten-Vorlagen (Admin erstellt Templates)
// =============================================
model ChecklistTemplate {
  id                String             @id @default(uuid())
  name              String // z.B. "Standard-Einstellung (TV-L)"
  description       String?
  questionnaireType QuestionnaireType? // Default-Zuordnung pro Typ (null = keine Auto-Zuordnung)
  isActive          Boolean            @default(true)

  items       ChecklistTemplateItem[]
  onboardings OnboardingProcess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist_templates")
}

// =============================================
// Checklisten-Vorlagen-Punkte (Items einer Vorlage)
// =============================================
model ChecklistTemplateItem {
  id         String            @id @default(uuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title           String // z.B. "Arbeitsvertrag unterschrieben"
  category        String // z.B. "Dokumente", "IT-Einrichtung", "Vor Arbeitsbeginn"
  orderIndex      Int     @default(0)
  defaultDueDays  Int? // Tage nach Vertragsbeginn (z.B. -7 = 7 Tage vorher)
  defaultAssignee String? // Standard-Verantwortlicher (z.B. "HR", "IT", "Vorgesetzter")

  createdAt DateTime @default(now())

  @@index([templateId])
  @@map("checklist_template_items")
}

// =============================================
// Checklisten-Eintraege (Instanzen pro Onboarding)
// =============================================
model ChecklistItem {
  id             String            @id @default(uuid())
  onboardingId   String
  onboarding     OnboardingProcess @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  templateItemId String? // Referenz zum Original-Template-Item

  title         String
  category      String
  orderIndex    Int       @default(0)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("CompletedChecklistItems", fields: [completedById], references: [id])
  dueDate       DateTime?
  assignee      String? // Verantwortlicher
  notes         String? // Optionale Notizen

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingId])
  @@map("checklist_items")
}

// =============================================
// Webhook-Konfigurationen (Admin-konfigurierbar, pro Event)
// =============================================
model WebhookConfig {
  id          String   @id @default(uuid())
  event       String // z.B. "onboarding-created", "questionnaire-completed"
  name        String // Anzeigename, z.B. "n8n Onboarding Workflow"
  url         String // Ziel-URL des Webhooks
  authType    String   @default("none") // "none" | "api_key" | "bearer" | "basic"
  authHeader  String? // Header-Name fuer API-Key (z.B. "X-API-Key")
  authValue   String? // Token / Passwort (sensibel – nicht im Frontend anzeigen)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([event])
  @@map("webhook_configs")
}

// =============================================
// SMTP-Konfiguration (Singleton, ID = "default")
// Fallback fuer E-Mail-Versand wenn n8n nicht erreichbar
// =============================================
model SmtpConfig {
  id        String   @id @default("default")
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false) // true = Port 465 (SSL), false = STARTTLS
  username  String   @default("")
  password  String   @default("") // Passwort – nur maskiert im Frontend anzeigen
  fromEmail String   @default("")
  fromName  String   @default("CREDO HR-Portal")
  isActive  Boolean  @default(false) // n8n ist primaer; SMTP nur als Fallback
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("smtp_config")
}

// =============================================
// E-Mail-Vorlagen (editierbar im Admin-Portal)
// Werden fuer SMTP-Fallback genutzt
// =============================================
model EmailTemplate {
  id        String   @id @default(uuid())
  event     String   @unique // korrespondiert mit WebhookEvent
  name      String // Anzeigename
  subject   String // E-Mail-Betreff (kann Variablen enthalten)
  bodyHtml  String // HTML-Body mit {{variablen}}
  bodyText  String? // Plaintext-Fallback
  variables Json // [{key: "{{vorname}}", description: "..."}]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// =============================================
// Formularvorlagen (konfigurierbare Fragebogen-Templates)
// =============================================
model FormTemplate {
  id                String            @id @default(uuid())
  questionnaireType QuestionnaireType @unique
  name              String // z.B. "Standard (TV-L)"
  description       String?
  stepsConfig       Json // Array: [{ step: 1, title: "...", enabled: true, fields: [...] }]
  isActive          Boolean           @default(true)

  // Pflicht-Dokumente fuer den Abschluss des Fragebogens (pro Vorlage konfigurierbar).
  // GEBURTSURKUNDE_KIND wird nur verlangt, wenn der Mitarbeiter Kinder angegeben hat.
  requiredDocuments DocumentType[]    @default([GEBURTSURKUNDE_EIGEN, GEBURTSURKUNDE_KIND])

  // Versionierung (Vorschlag 5)
  version     Int       @default(1) // Wird bei jeder Aenderung hochgezaehlt
  publishedAt DateTime? // Wann zuletzt veroeffentlicht

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("form_templates")
}

// =============================================
