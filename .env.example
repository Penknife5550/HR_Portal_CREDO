# =============================================================
# CREDO HR-Portal - Umgebungsvariablen
# Kopiere diese Datei als .env und passe die Werte an
# =============================================================

# Datenbank (PostgreSQL)
DATABASE_URL="postgresql://credo:sicheres_passwort_hier_aendern@localhost:5432/hr_portal?schema=public"

# Auth
JWT_SECRET="ein_langes_zufaelliges_geheimnis_min_32_zeichen_hier_aendern"
MAGIC_LINK_EXPIRY_HOURS=720

# Verschluesselung sensibler Daten (IBAN, SV-Nr, Steuer-ID)
# Generieren mit: openssl rand -hex 32
ENCRYPTION_KEY="64_zeichen_hex_string_hier_mit_openssl_rand_hex_32_generieren"

# Admin-Seed: Optionales initiales Passwort (wird zufaellig generiert wenn nicht gesetzt)
# ADMIN_INITIAL_PASSWORD="sicheres_passwort_hier"

# n8n Integration
N8N_WEBHOOK_BASE_URL="https://n8n.credo-intern.de/webhook"
N8N_API_KEY="optionaler_api_key_fuer_n8n"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Datei-Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
